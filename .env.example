# Copy to .env and fill in. docker compose loads it into the dev container.

# Supabase dev project → Project Settings → API keys / Data API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Only for the Supabase CLI targets (make db-push / make db-types)
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=

# Base URL used for links in reminder emails
APP_URL=http://localhost:5173

# Bearer token for /api/cron/reminders (e.g. `openssl rand -hex 32`)
CRON_SECRET=change-me-to-a-long-random-string

# AI features (contact import from text/screenshots, gift ideas). Leave empty to turn them off.
# Needs the Business plan for EU routing, plus the account settings listed in the README.
OPENROUTER_API_KEY=

# Leave RESEND_API_KEY empty in dev to print emails to the console instead of sending them
RESEND_API_KEY=
# Use the same sender name in Supabase's SMTP settings, so sign-in and reminder emails match
EMAIL_FROM=Birthday Reminder <emailer@birthdayreminder.eu>
